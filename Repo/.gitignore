# ==========================================================================
# RouteX .gitignore — Next.js / React / TypeScript app with Supabase
# ==========================================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# --- Package manager lockfile noise (keep ONE lockfile intentionally; not ignored by default) ---
# If you standardize on npm/pnpm/yarn later, uncomment the others' lockfiles here.

# --- Next.js ---
.next/
out/
build/
dist/
next-env.d.ts

# --- Environment variables / secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# --- Vercel ---
.vercel

# --- TypeScript ---
*.tsbuildinfo

# --- Local/dev database files (if any local DB tooling is used) ---
*.db
*.sqlite
*.sqlite3

# --- Supabase local dev ---
.supabase/
supabase/.branches
supabase/.temp

# --- Testing ---
coverage/
.nyc_output/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Misc caches ---
.cache/
.turbo/
.eslintcache

# --- Uploaded / generated artifacts that shouldn't be committed ---
/public/uploads/
*.tsbuildinfo
